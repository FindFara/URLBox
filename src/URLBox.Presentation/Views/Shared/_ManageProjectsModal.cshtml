@model IEnumerable<ProjectViewModel>
<div class="modal fade" id="projectsModal" tabindex="-1" aria-labelledby="projectsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header">
            <h5 id="projectsLabel" class="modal-title">Team projects</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            @foreach (var project in Model)
            {
                <div class="d-flex gap-2 mb-3">
                    <form asp-controller="Home" asp-action="SaveProject" method="post" class="d-flex flex-grow-1 gap-2">
                        <input type="hidden" name="teamId" value="@ViewBag.TeamId" />
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <input name="projectName" value="@project.Name" class="form-control" required aria-label="Project name" />
                        <input type="color" name="projectColor" value="@project.Color" class="form-control form-control-color" aria-label="Color for @project.Name" title="Project color" />
                        <button type="submit" class="btn btn-outline-primary">Save</button>
                    </form>
                    <form asp-controller="Home" asp-action="DeleteProject" method="post" onsubmit="return confirm('Delete this project?')">
                        <input type="hidden" name="teamId" value="@ViewBag.TeamId" />
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="btn btn-outline-danger">Delete</button>
                    </form>
                </div>
            }
            <form asp-controller="Home" asp-action="SaveProject" method="post" class="d-flex gap-2 border-top pt-3">
                <input type="hidden" name="teamId" value="@ViewBag.TeamId" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <input name="projectName" placeholder="New project name" class="form-control" required aria-label="New project name" />
                <input type="color" name="projectColor" value="@URLBox.Domain.Entities.ProjectColor.Resolve(null, Model.Select(p => p.Id).DefaultIfEmpty().Max() + 1)" class="form-control form-control-color" aria-label="New project color" title="Project color" />
                <button type="submit" class="btn btn-primary">Add</button>
            </form>
        </div>
    </div></div>
</div>
