@model List<URLBox.Domain.Entities.Team>
@{
    ViewData["Title"] = "Teams";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3 mb-1">Teams</h1><p class="text-muted mb-0">One shared login and URL collection per team.</p></div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">Dashboard</a>
</div>
@if (ViewBag.StatusMessage is string message) { <div class="alert alert-info" role="alert">@message</div> }
<div class="card card-body mb-4">
    <h2 class="h5">Create team</h2>
    <form asp-action="SaveTeam" method="post" class="row g-3 align-items-end">
        <div class="col-md-4"><label for="newTeamName" class="form-label">Team name</label><input id="newTeamName" name="Name" class="form-control" required maxlength="100" /></div>
        <div class="col-md-4"><label for="newTeamPassword" class="form-label">Shared password</label><input id="newTeamPassword" name="Password" type="password" class="form-control" required minlength="4" maxlength="100" autocomplete="new-password" /></div>
        <div class="col-md-2"><div class="form-check mb-2"><input id="newTeamAdmin" name="IsAdmin" type="checkbox" value="true" class="form-check-input" /><label for="newTeamAdmin" class="form-check-label">Administrator</label></div></div>
        <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Create</button></div>
    </form>
</div>
@foreach (var team in Model)
{
    <div class="card card-body mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">@team.Name <span class="badge text-bg-secondary">@team.Urls.Count URLs</span></h2>
            <a asp-action="Dashboard" asp-route-teamId="@team.Id" class="btn btn-sm btn-outline-secondary">View URLs</a>
        </div>
        <form asp-action="SaveTeam" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="Id" value="@team.Id" />
            <div class="col-md-4"><label for="name-@team.Id" class="form-label">Team name</label><input id="name-@team.Id" name="Name" value="@team.Name" class="form-control" required maxlength="100" /></div>
            <div class="col-md-4"><label for="password-@team.Id" class="form-label">New password (optional)</label><input id="password-@team.Id" name="Password" type="password" class="form-control" minlength="4" maxlength="100" autocomplete="new-password" /></div>
            <div class="col-md-2"><div class="form-check mb-2"><input id="admin-@team.Id" name="IsAdmin" type="checkbox" value="true" checked="@team.IsAdmin" class="form-check-input" /><label for="admin-@team.Id" class="form-check-label">Administrator</label></div></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Save changes</button></div>
        </form>
        <form asp-action="DeleteTeam" method="post" class="mt-3" onsubmit="return confirm('Delete this team and all its URLs?')">
            <input type="hidden" name="id" value="@team.Id" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete team</button>
        </form>
    </div>
}
