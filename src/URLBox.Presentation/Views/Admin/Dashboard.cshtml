@using System.Text.Json
@model URLBox.Presentation.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
    var selected = Model.SelectedTeam;
}
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
    <h1 class="h3 mb-0">Admin dashboard</h1>
    <a asp-action="TeamManager" class="btn btn-outline-primary">Manage teams</a>
</div>
@if (Model.StatusMessage is string message) { <div class="alert alert-info" role="alert">@message</div> }
<div class="row g-3 mb-4">
    <div class="col-6"><div class="card card-body"><span class="text-muted">Teams</span><span class="h3 mb-0">@Model.Teams.Count</span></div></div>
    <div class="col-6"><div class="card card-body"><span class="text-muted">URLs across teams</span><span class="h3 mb-0">@Model.TotalUrls</span></div></div>
</div>
<form asp-action="Dashboard" method="get" class="d-flex align-items-end flex-wrap gap-2 mb-4">
    <div class="flex-grow-1"><label for="dashboardTeam" class="form-label">Team</label>
        <select id="dashboardTeam" name="teamId" class="form-select">
            @foreach (var team in Model.Teams) { <option value="@team.Id" selected="@(team.Id == selected?.Id)">@team.Name</option> }
        </select>
    </div>
    <input type="hidden" name="urlSort" value="@Model.UrlSort" />
    <input type="hidden" name="descending" value="@Model.Descending.ToString().ToLowerInvariant()" />
    <button class="btn btn-primary" type="submit">View team</button>
</form>
@if (selected is not null)
{
    <div class="team-toolbar mb-4">
        <div class="team-toolbar-tags"><partial name="_ProjectFilter" model="Model.Projects" /></div>
        <div class="team-toolbar-name card px-4 py-2 text-center"><h2 class="h5 mb-0">@selected.Name</h2></div>
        <div class="team-toolbar-actions d-flex gap-2">
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#projectsModal">Projects</button>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#environmentsModal">Environments</button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUrlModal" disabled="@(Model.Projects.Count == 0 || selected.Environments!.Count == 0)">Add URL</button>
        </div>
    </div>
    <div class="alert alert-info" id="projectFilterEmpty" role="status" hidden>No URLs match the selected projects.</div>
    <div class="card shadow-sm" id="urls">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0">@selected.Name URLs</h2>
        </div>
        <div class="card-body">
            @if (Model.Urls.Count == 0) { <p class="text-muted mb-0">No URLs in this team yet.</p> }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle text-center mb-0">
                        <thead><tr>
                            @foreach (var column in new[] { (Key: "description", Label: "Description"), (Key: "url", Label: "URL"), (Key: "environment", Label: "Environment"), (Key: "project", Label: "Projects") })
                            {
                                var active = Model.UrlSort == column.Key;
                                <th scope="col" aria-sort="@(active ? (Model.Descending ? "descending" : "ascending") : "none")">
                                    <a asp-action="Dashboard" asp-route-teamId="@selected.Id" asp-route-urlSort="@column.Key" asp-route-descending="@(active && !Model.Descending)" asp-fragment="urls">
                                        @column.Label @(active ? (Model.Descending ? "↓" : "↑") : "")
                                    </a>
                                </th>
                            }
                            <th scope="col">Actions</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var url in Model.Urls)
                            {
                                <tr data-project-entry data-projects="@JsonSerializer.Serialize(url.ProjectTags)">
                                    <td>@url.Description</td><td class="text-break">@url.UrlValue</td><td>@url.Environment</td><td><partial name="_ProjectBadges" model="Model.Projects.Where(p => url.ProjectTags.Contains(p.Name))" /></td>
                                    <td><div class="d-flex justify-content-center gap-1">
                                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editUrlModal"
                                                data-url-id="@url.Id" data-url-team="@url.TeamId" data-url-value="@url.UrlValue" data-url-description="@url.Description"
                                                data-url-environment="@url.Environment" data-url-projects="@JsonSerializer.Serialize(url.ProjectTags)">Edit</button>
                                        <form asp-controller="Home" asp-action="DeleteUrl" method="post" onsubmit="return confirm('Delete this URL?')">
                                            <input type="hidden" name="teamId" value="@selected.Id" /><input type="hidden" name="id" value="@url.Id" />
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <partial name="_ManageProjectsModal" model="Model.Projects" />
    <partial name="_ManageEnvironmentsModal" model="selected.Environments" />
    <partial name="_AddUrlModal" model="Model.Projects" />
    <partial name="_EditUrlModal" model="Model.Projects" />
}
