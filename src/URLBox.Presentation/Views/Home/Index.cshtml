@model IList<URLBox.Application.ViewModel.UrlViewModel>
@{
    ViewData["Title"] = ViewBag.TeamName ?? "Team login";
    var projects = (ViewBag.Projects as IEnumerable<ProjectViewModel> ?? Enumerable.Empty<ProjectViewModel>()).ToList();
    var authenticated = User.Identity?.IsAuthenticated == true;
    var environments = (ViewBag.Environments as IEnumerable<string> ?? Enumerable.Empty<string>()).ToList();
}
@if (!authenticated)
{
    <div class="card shadow-sm login-card mx-auto mt-4">
        <div class="card-body p-4">
            <h1 class="h4">Team login</h1>
            <p class="text-muted">Enter your team's shared name and password.</p>
            @if (ViewBag.LoginError is string error)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="ReturnUrl" value="@ViewBag.LoginReturnUrl" />
                <div class="mb-3">
                    <label for="teamName" class="form-label">Team name</label>
                    <input id="teamName" name="TeamName" class="form-control" required autocomplete="username" autofocus />
                </div>
                <div class="mb-3">
                    <label for="teamPassword" class="form-label">Password</label>
                    <input id="teamPassword" name="Password" type="password" class="form-control" required autocomplete="current-password" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign in</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="team-toolbar mb-4">
        <div class="team-toolbar-tags"><partial name="_ProjectFilter" model="projects" /></div>
        <div class="team-toolbar-name d-flex align-items-stretch gap-2">
            @if (environments.Count > 5)
            {
                <button type="button" class="btn environment-nav" data-environment-previous aria-label="Previous environments" title="Previous environments" aria-controls="environmentColumns" disabled>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                </button>
            }
            <div class="card px-4 py-2 text-center d-flex justify-content-center"><h1 class="h5 mb-0">@ViewBag.TeamName</h1></div>
            @if (environments.Count > 5)
            {
                <button type="button" class="btn environment-nav" data-environment-next aria-label="Next environments" title="Next environments" aria-controls="environmentColumns">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                </button>
            }
        </div>
        <div class="team-toolbar-actions d-flex gap-2">
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#projectsModal">Projects</button>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#environmentsModal">Environments</button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUrlModal" disabled="@(projects.Count == 0 || environments.Count == 0)">Add URL</button>
        </div>
    </div>
    <div class="alert alert-info" id="projectFilterEmpty" role="status" hidden>No URLs match the selected projects.</div>
    @if (ViewBag.StatusMessage is string message)
    {
        <div class="alert alert-@(ViewBag.StatusMessageType ?? "info")" role="alert">@message</div>
    }
    @if (projects.Count == 0)
    {
        <div class="alert alert-info">Create a project using the Projects button to add your first URL.</div>
    }
    @if (environments.Count == 0)
    {
        <div class="alert alert-info">Create your first environment using Environments to add URL columns.</div>
    }
    <div class="environment-columns" id="environmentColumns" style="--environment-columns: @Math.Min(Math.Max(environments.Count, 1), 5); --environment-mobile-columns: @Math.Min(Math.Max(environments.Count, 1), 2)">
        @for (var environmentIndex = 0; environmentIndex < environments.Count; environmentIndex++)
        {
            var environment = environments[environmentIndex];
            <div data-environment-column hidden="@(environmentIndex >= 5)">
                <h2 class="h5 mb-3">@environment</h2>
                @foreach (var url in Model.Where(u => u.Environment.Equals(environment, StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="card shadow-sm mb-3" data-project-entry data-projects="@System.Text.Json.JsonSerializer.Serialize(url.ProjectTags)">
                        <div class="card-body text-center">
                            <h3 class="h6">@url.Description</h3>
                            <div class="d-flex flex-wrap justify-content-center gap-1 mb-2">
                                <partial name="_ProjectBadges" model="projects.Where(p => url.ProjectTags.Contains(p.Name))" />
                            </div>
                            <p class="small text-break text-muted">@url.UrlValue</p>
                            <div class="d-flex flex-wrap justify-content-center gap-1">
                                <a href="@url.UrlValue" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">Open</a>
                                <button type="button" data-copy-url="@url.UrlValue" class="btn btn-sm btn-outline-secondary">Copy</button>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editUrlModal"
                                        data-url-id="@url.Id" data-url-team="@url.TeamId" data-url-value="@url.UrlValue" data-url-description="@url.Description"
                                        data-url-environment="@url.Environment" data-url-projects="@System.Text.Json.JsonSerializer.Serialize(url.ProjectTags)">Edit</button>
                                <form asp-action="DeleteUrl" method="post" onsubmit="return confirm('Delete this URL?')">
                                    <input type="hidden" name="id" value="@url.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <partial name="_ManageProjectsModal" model="projects" />
    <partial name="_ManageEnvironmentsModal" model="environments" />
    <partial name="_AddUrlModal" model="projects" />
    <partial name="_EditUrlModal" model="projects" />
    <script src="~/js/environment-navigation.js" asp-append-version="true" defer></script>
}
